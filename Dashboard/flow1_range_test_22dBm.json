    {
        "id": "26f60cd0b8a304ab",
        "type": "function",
        "z": "0c4d30b5c1775d3e",
        "name": "Results",
        "func": "// 1. Παίρνουμε την τρέχουσα ώρα (Timestamp)\nvar date = new Date();\nvar timestamp = date.toLocaleTimeString(); // Ώρα π.χ. \"19:30:05\"\n\n// 2. Παίρνουμε τα βασικά δεδομένα\nvar count = msg.payload.cnt;\nvar rssi = msg.payload.rssi;\nvar snr = msg.payload.snr;\n\n// 3. Βγάζουμε το ORP (όπως κάναμε πριν)\nvar text = msg.payload.msg;\nvar orp = \"0\"; // Default τιμή αν κάτι πάει στραβά\n\n// Ασφαλής έλεγχος για να μην κρασάρει αν λείπει κάτι\nif (text && text.includes(\"|\") && text.includes(\":\")) {\n    var parts = text.split(\"|\");\n    if (parts.length > 2) {\n        var orpPart = parts[2].split(\":\");\n        if (orpPart.length > 1) {\n            orp = orpPart[1];\n        }\n    }\n}\n\n// 4. Φτιάχνουμε τη γραμμή για το CSV (χωρισμένα με κόμμα)\n// Προσθέτουμε και αλλαγή γραμμής (\\n) στο τέλος\nmsg.payload = timestamp + \",\" + count + \",\" + rssi + \",\" + snr + \",\" + orp + \"\\n\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 480,
        "wires": [
            [
                "ee4719326b61536d"
            ]
        ]
    },
    {
        "id": "368d109ebb92b09c",
        "type": "function",
        "z": "0c4d30b5c1775d3e",
        "name": "Sender Packet ID",
        "func": "// Το μήνυμα είναι π.χ.: \"ID:1|CNT:30|ORP:6.9\"\nvar raw_msg = msg.payload.msg;\n\n// 1. Σπάμε το μήνυμα στις κάθετες γραμμές \"|\"\nvar parts = raw_msg.split(\"|\"); \n// Τώρα το parts[1] είναι \"CNT:30\"\n\n// 2. Σπάμε το δεύτερο κομμάτι στην άνω-κάτω τελεία \":\"\nvar count_part = parts[1].split(\":\");\n// Τώρα το count_part[1] είναι \"30\"\n\n// 3. Το μετατρέπουμε σε καθαρό αριθμό\nvar real_packet_id = parseInt(count_part[1]);\n\n// 4. Το βάζουμε στο payload για να το δει το γράφημα\nmsg.payload = real_packet_id;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 540,
