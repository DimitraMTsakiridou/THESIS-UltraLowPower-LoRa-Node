    {
        "id": "5d950d5849c6453e",
        "type": "function",
        "z": "0c4d30b5c1775d3e",
        "name": "ORP value",
        "func": "// Το μήνυμα είναι: \"ID:1|CNT:7|ORP:5.2\"\nvar text = msg.payload.msg; \n\n// Το κόβουμε εκεί που έχει '|'\nvar parts = text.split(\"|\"); \n// Τώρα το parts[2] είναι \"ORP:5.2\"\n\n// Το κόβουμε εκεί που έχει ':' και παίρνουμε το δεύτερο κομμάτι\nvar valueString = parts[2].split(\":\")[1]; \n// Τώρα έχουμε το \"5.2\"\n\n// Το μετατρέπουμε σε αριθμό για το γράφημα\nmsg.payload = parseFloat(valueString);\n\nreturn msg;",
